# 一阕 · .gitignore
#
# 原则（见 docs/design/build.md）：
#   上游数据与构建产物均不入版本控制，只有管道代码入版本控制。
#   构建可复现：删除产物重新构建，结果应当一致。
#
# 因此下面对 public/ 只忽略生成出来的子目录，不忽略整个 public/——
# 手工维护的品牌资源、favicon、站点图标等必须入库。

# ─────────────── 依赖 ───────────────
node_modules/

# ─────────────── 构建产物 ───────────────
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ─────────────── 数据：上游原始数据 ───────────────
# 体积大、需联网获取、由数据管道拉取，不入库。
data/upstream/

# ─────────────── 数据：字体源文件 ───────────────
# 全量中文字体动辄二十余兆，且子集化在构建期完成，源字体不入库。
# 产物是 40KB 的扩展区 fallback 子集，见 docs/design/20-corpus-pipeline.md。
data/fonts/
*.ttc
*.otf
*.ttf

# ─────────────── 数据：管道静态产物 ───────────────
# 全部由数据管道生成，入库会造成「二进制大文件 + 每次重建产生无意义 diff」。
public/corpus/
public/fonts/

# ─────────────── 环境变量 ───────────────
.env
.env.*
!.env.example

# ─────────────── 测试与覆盖率 ───────────────
coverage/
.nyc_output/

# ─────────────── 日志 ───────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ─────────────── 编辑器与 IDE ───────────────
.idea/
*.swp
*.swo
*~

# ─────────────── 操作系统 ───────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────── 临时文件 ───────────────
tmp/
temp/
*.tmp
*.bak
